#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

CURRENT_CONTEXT="$(kubectl config current-context)"

if [[ "${CURRENT_CONTEXT}" != "kind-kind" ]]; then
    printf 'Refusing to run in "%s" context (expecting "kind-kind")\n' "${CURRENT_CONTEXT}" >&2
    exit 86
fi

./script/test-smoke
./script/test-failover
