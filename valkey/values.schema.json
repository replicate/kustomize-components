{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["global", "valkey", "sentinel", "envoy"],
    "properties": {
      "global": {
        "type": "object",
        "required": ["namespace"],
        "properties": {
          "namespace": {
            "type": "string",
            "description": "The namespace for the Valkey deployment."
          },
          "topology_spread_constraints": {
            "type": "object",
            "required": ["enabled", "label_selector", "max_skew", "topology_key", "when_unsatisfiable"],
            "properties": {
              "enabled": {
                "type": "boolean",
                "default": false,
                "description": "Enable topology spread constraints for the Valkey deployment."
              },
              "label_selector": {
                "type": "string",
                "description": "The label selector for the topology spread constraints."
              },
              "max_skew": {
                "type": "integer",
                "description": "The maximum skew for the topology spread constraints."
              },
              "topology_key": {
                "type": "string",
                "description": "The topology key for the topology spread constraints."
              },
              "when_unsatisfiable": {
                "type": "string",
                "description": "The action to take when the topology spread constraints are not satisfied."
              }
            }
          }
        }
      },
      "valkey": {
        "type": "object",
        "required": ["servers", "image"],
        "properties": {
          "image": {
            "type": "string",
            "description": "The image for the Valkey server, defaults to valkey/valkey:8.1-alpine."
          },
          "servers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$",
                  "description": "The name of the Valkey server. Must be a valid DNS subdomain name."
                },
                "resources": {
                  "type": "object",
                  "properties": {
                    "requests": {
                      "type": "object",
                      "properties": {
                        "requests": {
                          "type": "object",
                          "properties": {
                            "cpu": {
                              "type": "string",
                              "description": "The CPU request for the Valkey server."
                            },
                            "memory": {
                              "type": "string",
                              "description": "The memory request for the Valkey server."
                            }
                          }
                        },
                        "limits": {
                          "type": "object",
                          "properties": {
                            "cpu": {
                              "type": "string",
                              "description": "The CPU limit for the Valkey server."
                            },
                            "memory": {
                              "type": "string",
                              "description": "The memory limit for the Valkey server."
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "replicas": {
                  "type": "integer",
                  "default": 2,
                  "description": "The number of replicas for the Valkey server, defaults to 2."
                },
                "down_after_milliseconds": {
                  "type": "integer",
                  "default": 3000,
                  "description": "The number of milliseconds the master should wait for a slave to be reconfigured as a slave of another master after a failover. Defaults to 3000."
                },
                "failover_timeout": {
                  "type": "integer",
                  "default": 10000,
                  "description": "The failover timeout in milliseconds, defaults to 10000."
                },
                "parallel_syncs": {
                  "type": "integer",
                  "default": 1,
                  "description": "The number of slaves that can be reconfigured as slaves of another master after a failover. Defaults to 1."
                },
                "storage": {
                  "type": "object",
                  "properties": {
                    "size": {
                      "type": "string",
                      "default": "1Gi",
                      "description": "The size of the storage for the Valkey server, defaults to 1Gi."
                    }
                  }
                }
              }
            }
          }
        }
      },
      "sentinel": {
        "type": "object",
        "required": ["replicas"],
        "properties": {
          "replicas": {
            "type": "integer",
            "default": 3,
            "description": "The number of replicas for the Sentinel, defaults to 3."
          }
        }
      }
    }
  }